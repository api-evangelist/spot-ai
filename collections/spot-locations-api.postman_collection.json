                  "key": "cursor",
                  "value": "<string>",
                  "description": "Cursor for pagination"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Number of locations to return in a single response. Default is\n`50`. Maximum allowed is `100`."
                }
              ],
              "variable": []
